# everforest ===================================================================
set font "cascaydiacove nerd font 15"

# Background and Foreground
set default-bg "#1E2326"        # bg (hard)
set default-fg "#d3c6aa"        # fg (text)

# Statusbar
set statusbar-fg "#a7c080"      # green (dimmed)
set statusbar-bg "#3c474d"      # grey2 / surface

# Inputbar
set inputbar-bg "#323c41"       # grey1 / base
set inputbar-fg "#d3c6aa"       # fg

# Notification Colors
set notification-error-bg "#e67e80"     # red
set notification-error-fg "#2b3339"     # bg

set notification-warning-bg "#dbbc7f"   # yellow
set notification-warning-fg "#2b3339"   # bg

set notification-bg "#7fbbb3"           # aqua (used as info/iris equivalent)
set notification-fg "#2b3339"           # bg

# Highlights
set highlight-color "#dbbc7f"           # yellow (used for soft highlight)
set highlight-active-color "#7fbbb3"    # aqua (active highlight)

# Completion Menu
set completion-highlight-fg "#2b3339"   # bg
set completion-highlight-bg "#a7c080"   # green

set completion-bg "#3a454a"             # grey3 / overlay
set completion-fg "#d3c6aa"             # fg

# Recolor settings
set recolor "true"
set recolor-lightcolor "rgba(43, 51, 57, 0)"     # transparent bg
set recolor-darkcolor "rgba(211, 198, 170, 1)"   # fg (text)
set recolor-reverse-video "true"
set recolor-keephue "true"

set selection-clipboard clipboard
set render-loading "false"
set scroll-step 50
