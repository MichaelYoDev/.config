# Zathura configuration file
# See man `man zathurarc'

# One page per row by default
set pages-per-row 1

#stop at page boundries
set scroll-page-aware "true"
set scroll-full-overlap 0.01
set scroll-step 0.01

# maps
map r reload
map p print
map i recolor
map J zoom out
map K zoom in
map R rotate

# better scrolling
map j feedkeys "<C-Down>"
map k feedkeys "<C-Up>"
set scroll-step 5

#zoom settings
set zoom-min 10
set guioptions ""

# zathurarc-dark
set font "jetbrainsmono nerd font 15"
set default-bg "rgba(31, 29, 46, .8)"
set default-fg "#e0def4"        # text

set statusbar-fg "#908caa"      # foam
set statusbar-bg "#26233a"      # surface

set inputbar-bg "#1f1d2e"       # base
set inputbar-fg "#e0def4"       # text

set notification-error-bg "#eb6f92" # love
set notification-error-fg "#191724" # base

set notification-warning-bg "#f6c177"   # gold
set notification-warning-fg "#191724"   # base

set highlight-color "#f6c177"           # gold
set highlight-active-color "#31748f"    # iris

set completion-highlight-fg "#191724"   # base
set completion-highlight-bg "#9ccfd8"   # foam (highlight variant)

set completion-bg "#2a273f"     # overlay
set completion-fg "#e0def4"     # text

set notification-bg "#31748f"   # iris
set notification-fg "#191724"   # base

set recolor "true"
set recolor-lightcolor "rgba(31, 29, 46, 0)"  # base, transparent
set recolor-darkcolor "rgba(224, 222, 244, 1)" # text
set recolor-reverse-video "true"
set recolor-keephue "true"

set selection-clipboard clipboard
set render-loading "false"
set scroll-step 50
