let mapleader = " "

set guicursor=
set number
set relativenumber
set signcolumn=yes
set mouse=a

set expandtab
set shiftwidth=4
set smartindent
set softtabstop=4
set tabstop=4

set linebreak
set spell spelllang=en_us
set wrap
set wrapmargin=0

set clipboard=unnamedplus
set noswapfile

set ignorecase
set smartcase

map j gj
map k gk

syntax on
colorscheme rosepine
hi Normal guibg=NONE ctermbg=NONE
hi SignColumn guibg=NONE ctermbg=NONE
